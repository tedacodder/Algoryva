generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum Level {
  FOUNDATION
  BEGINNER
  CORE
  INTERMEDIATE
  ADVANCED
  EXPERT
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  COMING_SOON
}
enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}
enum Visibility {
  PRIVATE
  PUBLIC
}
enum ProblemKind {
  INTERNAL
  EXTERNAL
}
enum ResourceKind {
  PDF
  ARTICLE
  VIDEO
  VISUALIZATION
  DOCS
  PROBLEM_COLLECTION
}
enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
}
/// How a solve was established. OUTPUT_MATCHED: pasted output matched every server-side test, including a hidden one.
/// SELF_REPORTED: the learner marked an external problem solved (external problems can never be judged).
/// LEGACY_UNVERIFIED: recorded before this column existed, or otherwise not provably either of the above. Never ranked as verified.
enum SolveVerification {
  OUTPUT_MATCHED
  SELF_REPORTED
  LEGACY_UNVERIFIED
}

enum UpsolveReason {
  COULD_NOT_SOLVE
  SOLVED_AFTER_EDITORIAL
  SOLVED_AFTER_HINT
  IMPLEMENTATION_ERROR
  MISUNDERSTOOD
  RAN_OUT_OF_TIME
}
enum MistakeType {
  CONCEPTUAL
  IMPLEMENTATION
  COMPLEXITY
  EDGE_CASE
  MISREAD
  DEBUGGING
  TIME_MANAGEMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  suspended    Boolean  @default(false)
  preferredLanguage String @default("python")
  createdAt    DateTime @default(now())
  progress     TopicProgress[]
  submissions  Submission[]
  mistakes     Mistake[]
  reviews      ReviewItem[]
  sessions     Session[]
  solves       ProblemSolve[]
  notes        Note[]
  activities   Activity[]
  experience   String?
  onboarded    Boolean @default(false)
  emailVerifiedAt DateTime?
  pendingEmail String?
  revisitEmails    Boolean @default(true)
  revisitEmailedAt DateTime?
  revisits         Revisit[]
  syncEvents       SyncEvent[]
  tokens       VerificationToken[]
  contestEntries ContestEntry[]
  quizResults  QuizResult[]
  telegramLink TelegramLink?
  challengeAssignments ChallengeAssignment[]
  telegramRecipients TelegramRecipient[]
  referralCode ReferralCode?
  botRewards BotReward[]
  clubMembership ClubMembership?
  ledClubs Club[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  device    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Topic {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String        @default("")
  level     Level
  status    ContentStatus @default(DRAFT)
  position  Int           @default(0)
  prerequisites TopicPrerequisite[] @relation("dependent")
  dependents    TopicPrerequisite[] @relation("prerequisite")
  lessons   Lesson[]
  problems  ProblemTopic[]
  resources ResourceTopic[]
  progress  TopicProgress[]
  quizResults QuizResult[]
  @@index([level, position])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  topic          Topic @relation("dependent", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   Topic @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  @@id([topicId, prerequisiteId])
}

model Lesson {
  id       String        @id @default(cuid())
  topicId  String
  slug     String
  title    String
  status   ContentStatus @default(DRAFT)
  position Int           @default(0)
  // Sections hold concept/intuition/example/mistakes text; code examples are per language.
  sections LessonSection[]
  topic    Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([topicId, slug])
}

model LessonSection {
  id       String @id @default(cuid())
  lessonId String
  kind     String // intro | intuition | example | mistakes | complexity
  language String? // null = language-neutral prose; else python | cpp | java | js
  body     String
  position Int    @default(0)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId, position])
}

// One abstraction for both kinds: INTERNAL uses statement/testcases, EXTERNAL uses url/source only.
model Problem {
  id         String      @id @default(cuid())
  slug       String      @unique
  title      String
  kind       ProblemKind
  difficulty Difficulty
  status     ContentStatus @default(DRAFT)
  source     String?     // e.g. leetcode, codeforces
  externalUrl String?
  statement  String?     // INTERNAL only; never copy third-party statements
  timeLimitMs Int?
  memoryLimitMb Int?
  inputSpec  String?
  outputSpec String?
  constraints String?
  position   Int @default(0)
  normalizedUrl String? @unique // canonical URL; prevents duplicate external links
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  solves     ProblemSolve[]
  revisits   Revisit[]
  contests   ContestProblem[]
  topics     ProblemTopic[]
  testCases  TestCase[]
  submissions Submission[]
  mistakes   Mistake[]
  challengeAssignments ChallengeAssignment[]
  @@index([kind, difficulty])
}

model ProblemTopic {
  problemId String
  topicId   String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([problemId, topicId])
  @@index([topicId])
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  input     String
  expected  String
  isSample  Boolean @default(false)
  explanation String?
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([problemId])
}

model Submission {
  id        String @id @default(cuid())
  userId    String
  problemId String
  language  String
  code      String
  status    SubmissionStatus @default(PENDING)
  runtimeMs Int?
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([userId, problemId, createdAt])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  kind        ResourceKind
  author      String?
  source      String?
  license     String?      // record actual permission; never assume
  externalUrl String?
  filePath    String?
  visibility  Visibility   @default(PRIVATE)
  topics      ResourceTopic[]
}

model ResourceTopic {
  resourceId String
  topicId    String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([resourceId, topicId])
}

model TopicProgress {
  userId      String
  topicId     String
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([userId, topicId])
}

model Mistake {
  id        String      @id @default(cuid())
  userId    String
  problemId String?
  outsideTitle String?   // a problem that is not on this site, typed by the learner
  outsideUrl   String?   // optional https link to that problem
  type      MistakeType
  misunderstood String
  correctIdea   String
  recognizeNextTime String
  reason    UpsolveReason?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  @@index([userId, type])
}

model ReviewItem {
  id       String   @id @default(cuid())
  userId   String
  topicId  String
  dueAt    DateTime
  step     Int      @default(0) // index into 1,3,7,14,30 day ladder
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, topicId])
  @@index([userId, dueAt])
}

model ProblemSolve {
  userId    String
  problemId String
  solvedAt  DateTime @default(now())
  verification SolveVerification @default(LEGACY_UNVERIFIED)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@id([userId, problemId])
  @@index([problemId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // topic_complete | problem_solved | review
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  type      String   // reset | verify
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
}

model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model Contest {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  durationMin Int
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  problems    ContestProblem[]
  entries     ContestEntry[]
}

model ContestProblem {
  contestId String
  problemId String
  label     String
  position  Int
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@id([contestId, problemId])
  @@index([problemId])
}

model ContestEntry {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  startedAt DateTime @default(now())
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  solves    ContestSolve[]
  @@unique([contestId, userId])
}

model ContestSolve {
  entryId   String
  problemId String
  solvedAt  DateTime @default(now())
  verification SolveVerification @default(LEGACY_UNVERIFIED)
  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@id([entryId, problemId])
}

// Best mastery-check result per user and topic. Passing is one of several mastery signals (see lib/mastery.ts); it never gates completing a topic.
model QuizResult {
  userId    String
  topicId   String
  bestScore Int
  total     Int
  attempts  Int       @default(1)
  passedAt  DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([userId, topicId])
}

model Revisit {
  id           String    @id @default(cuid())
  userId       String
  problemId    String?   // set for a problem on this site (judge-graded)
  outsideTitle String?   // set for a problem outside the site (self-reported)
  outsideUrl   String?
  outsideKey   String?   // normalised link or title, so the same outside problem is queued once
  dueAt        DateTime? // null = no more reminders (passed, or the last reminder was sent)
  step         Int       @default(0) // reminders sent so far
  passedAt     DateTime?
  passedBy     String?   // "judge" (verified on this site) or "self" (outside problem)
  note         String?   // the explanation an outside problem requires
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem?  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@unique([userId, problemId])
  @@unique([userId, outsideKey])
  @@index([userId, dueAt])
}

/// Idempotency record for the mobile API (/api/v1/sync/push and /api/v1/submissions). One row per client-generated
/// event id, per user. `payloadHash` identifies the content so an id reused for different content is a conflict, and
/// `outcome` is the final result that a duplicate request gets back. Nothing on the website reads or writes it.
model SyncEvent {
  userId      String
  id          String
  type        String
  payloadHash String
  outcome     Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

/// Links one Algoryva account to one Telegram account. The Telegram user id itself is never stored: only an HMAC of it,
/// keyed by a secret derived from TELEGRAM_BOT_API_SECRET, so a database copy cannot reveal Telegram identities.
model TelegramLink {
  userId          String   @id
  telegramHash    String   @unique
  createdAt       DateTime @default(now())
  /// Off by default. Only opted-in accounts appear on the bot's public leaderboard.
  leaderboardOptIn Boolean @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A single-use, expiring link token. Only the SHA-256 of the token is stored. The row is not tied to an account until it is
/// consumed, and expired or used rows are pruned.
model TelegramLinkChallenge {
  id           String    @id @default(cuid())
  telegramHash String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  @@index([telegramHash, createdAt])
}

/// Replay protection for signed bot requests. Rows older than the signature window are pruned.
model BotNonce {
  nonce     String   @id
  createdAt DateTime @default(now())
  @@index([createdAt])
}

/// The one daily challenge a user is given on a UTC day. Unique per user and day, so a repeated request returns the same problem.
model ChallengeAssignment {
  id        String   @id @default(cuid())
  userId    String
  day       String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@unique([userId, day])
  @@index([userId, createdAt])
}

/// A Telegram chat that receives community messages: a private chat that started the bot, or a group an admin enabled.
/// The chat id is stored encrypted (it is needed to send messages). Only its keyed hash is used for lookups.
/// userId is set when the chat is linked to an Algoryva account; deleting that account deletes this row.
model TelegramRecipient {
  id            String   @id @default(cuid())
  chatHash      String   @unique
  chatCipher    String
  kind          String
  userId        String?
  dailyCf       Boolean  @default(true)
  contestAlerts Boolean  @default(true)
  blocked       Boolean  @default(false)
  referrerCode  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]
  cfHandles     CfHandle[]
  groupRoster   GroupRoster[]
  groupDaily    GroupDaily?
  @@index([userId])
}

/// One community message to one chat. The unique key makes each daily problem and each contest reminder happen once per chat.
model NotificationDelivery {
  id          String    @id @default(cuid())
  recipientId String
  kind        String
  key         String
  ref         String?
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastTriedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([recipientId, kind, key])
  @@index([status, createdAt])
}

/// Cached public Codeforces API responses. Keeps calls far under Codeforces' limit of one request per two seconds.
model CfCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime
}

/// A user's referral code. Shared as a deep link; a referral counts only after the referred account has an output-matched solve.
model ReferralCode {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A weekly reward earned by verified work. Unique per user, kind and week, so each reward is granted once.
model BotReward {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  periodKey String
  detail    String?
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, periodKey])
  @@index([userId])
}

/// Marks a calendar week as already awarded, so the awarding step does nothing on later runs.
model RewardPeriod {
  periodKey String   @id
  awardedAt DateTime @default(now())
}

/// A university or study club. Any linked student can create one. Members join with the invite code. The board shows club names and
/// scores only, never member names.
model Club {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  leaderUserId String
  createdAt    DateTime @default(now())
  leader       User     @relation(fields: [leaderUserId], references: [id], onDelete: Cascade)
  members      ClubMembership[]
}

/// One club per student. Deleting the student or the club removes the membership.
model ClubMembership {
  clubId   String
  userId   String   @unique
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([clubId, userId])
}

/// A Codeforces handle connected to a chat (a private chat, or a group where a member ran /connect).
/// Used to skip problems the chat's handles have already solved.
model CfHandle {
  id          String   @id @default(cuid())
  recipientId String
  handle      String
  linkedAt    DateTime @default(now())
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([recipientId, handle])
  @@index([handle])
}

/// Codeforces handles a group admin expects to see in the group (the class roster). Telegram does not let a bot list group
/// members, so the roster is the admin's list of handles. A handle counts as registered once it has run /connect with the bot.
model GroupRoster {
  id          String   @id @default(cuid())
  recipientId String
  handle      String
  addedAt     DateTime @default(now())
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([recipientId, handle])
}

/// The problem a group uses instead of the default daily problem. Removed when the admin resets it.
model GroupDaily {
  recipientId String   @id
  problemRef  String
  setAt       DateTime @default(now())
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

